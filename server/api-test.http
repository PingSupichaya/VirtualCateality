@baseUrl = http://localhost:3000/api

### Google login (paste a real Google ID token as credential)
POST {{baseUrl}}/auth/google HTTP/1.1
Content-Type: application/json

{
    "credential": "PASTE_GOOGLE_ID_TOKEN_HERE"
}

### Current user profile (requires Bearer token from /auth/google)
GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: Bearer PASTE_APP_JWT_HERE

### List all cats
GET {{baseUrl}}/cats HTTP/1.1

### Get a single cat
GET {{baseUrl}}/cats/1 HTTP/1.1

### List quiz questions + answers + stories
GET {{baseUrl}}/quiz/questions HTTP/1.1

### Submit quiz answers (one answerId per question) and get matching cats
POST {{baseUrl}}/quiz/result HTTP/1.1
Content-Type: application/json

{
    "answerIds": [11, 21, 31, 41, 51, 61, 71]
}

### Get the logged-in user's saved cat
GET {{baseUrl}}/user/selected-cat HTTP/1.1
Authorization: Bearer PASTE_APP_JWT_HERE

### Save the logged-in user's selected cat
POST {{baseUrl}}/user/selected-cat HTTP/1.1
Authorization: Bearer PASTE_APP_JWT_HERE
Content-Type: application/json

{
    "catId": 3
}
